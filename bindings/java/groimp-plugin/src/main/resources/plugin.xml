<?xml version="1.0" encoding="UTF-8"?>
<!-- GroIMP's encoding3d plugin: File > Export (or the CLI's export3d) to a .glb file writes the 3D view as an encoding3d frame.
     The shapes are meshed by GroIMP's glTF plugin (de.grogra.gltf), each mesh with its node. -->
<plugin
	id="org.openalea.encoding3d"
	version="0.1.0"
	xmlns="http://grogra.de/registry">

	<!-- the codec and GroIMP's adapter (encoding3d, encoding3d-groimp) are in ext/, loaded by GroIMP as extensions -->
	<library file="encoding3d.jar" prefixes="{org.openalea.encoding3d.groimp.plugin}" />

	<import plugin="de.grogra.imp3d" />
	<import plugin="de.grogra.rgg" />
	<import plugin="de.grogra.gltf" />
	<registry>
		<ref name="io">
			<ref name="filetypes">
				<ext name="encoding3d" extensions="{.glb}" mimeType="model/encoding3d" />
			</ref>
			<ref name="mimetypes">
				<ref name="application/x-java-jvm-local-objectref">
					<filter name="encoding3dExport"
						inputClass="de.grogra.imp3d.View3D"
						output="model/encoding3d; io=fwriter"
						create="org.openalea.encoding3d.groimp.plugin.Encoding3dExport">
						<eval name="de.grogra.imp3d.objects.Box"
							create="de.grogra.gltf.exporter.objects.Box" />
						<eval name="de.grogra.imp3d.objects.Cylinder"
							create="de.grogra.gltf.exporter.objects.Cylinder" />
						<eval name="de.grogra.imp3d.objects.Sphere"
							create="de.grogra.gltf.exporter.objects.Sphere" />
						<eval name="de.grogra.turtle.Translate"
							create="de.grogra.gltf.exporter.objects.Translate" />
						<eval name="de.grogra.imp3d.objects.Parallelogram"
							create="de.grogra.gltf.exporter.objects.Parallelogram" />
						<eval name="de.grogra.imp3d.objects.Cone"
							create="de.grogra.gltf.exporter.objects.Cone" />
						<eval name="de.grogra.imp3d.objects.Frustum"
							create="de.grogra.gltf.exporter.objects.Frustum" />
						<eval name="de.grogra.imp3d.objects.Plane"
							create="de.grogra.gltf.exporter.objects.Plane" />
						<eval name="de.grogra.imp3d.objects.MeshNode"
							create="de.grogra.gltf.exporter.objects.Polygonizable" />
						<eval name="de.grogra.imp3d.objects.NURBSSurface"
							create="de.grogra.gltf.exporter.objects.Polygonizable" />
						<eval name="de.grogra.imp3d.objects.Patch"
							create="de.grogra.gltf.exporter.objects.Polygonizable" />
						<eval name="de.grogra.imp3d.objects.Polygon"
							create="de.grogra.gltf.exporter.objects.Polygonizable" />
						<eval name="de.grogra.graph.impl.Node"
							create="de.grogra.gltf.exporter.objects.Node" />
					</filter>
				</ref>
			</ref>
		</ref>
	</registry>
</plugin>
