{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/openalea/encoding3d/schema/0.3/views.schema.json",
 "title": "encoding3d frame views",
 "description": "views.json, an optional companion of a sequence (next to its scene.fspm.json) or of a frame: named configurations of layers, each layer a part of a data structure (a mesh, segments or a grid), the entities it selects and how it is drawn (encoding3d 0.3, §8.1).",
 "type": "object",
 "required": ["encoding3d_views", "configurations"],
 "properties": {
  "encoding3d_views": {"const": 1},
  "active": {"type": "string", "minLength": 1},
  "configurations": {"type": "object", "minProperties": 1,
                     "additionalProperties": {"$ref": "#/$defs/configuration"}},
  "extras": {}
 },
 "additionalProperties": false,
 "$defs": {
  "configuration": {
   "type": "object", "required": ["layers"],
   "properties": {"layers": {"type": "array", "items": {"$ref": "#/$defs/layer"}}, "extras": {}},
   "additionalProperties": false},
  "layer": {
   "type": "object", "required": ["name", "source"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "select": {"type": "object", "required": ["entity_set", "where"],
               "properties": {"entity_set": {"type": "string", "minLength": 1},
                              "where": {"type": "object", "additionalProperties": {"$ref": "#/$defs/condition"}}},
               "additionalProperties": false},
    "color_by": {"oneOf": [{"type": "null"},
                           {"type": "object", "required": ["entity_set", "variable"],
                            "properties": {"entity_set": {"type": "string", "minLength": 1},
                                           "variable": {"type": "string", "minLength": 1}},
                            "additionalProperties": false}]},
    "solid_color": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1},
                    "minItems": 3, "maxItems": 3},
    "colormap": {"type": "string", "minLength": 1},
    "range": {"oneOf": [{"const": "auto"},
                        {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}]},
    "log": {"type": "boolean"},
    "opacity": {"type": "number", "minimum": 0, "maximum": 1},
    "visible": {"type": "boolean"},
    "representation": {"enum": ["Surface", "Surface With Edges", "Wireframe", "Points", "Outline"]},
    "tube": {"type": "object", "required": ["radius"],
             "properties": {"radius": {"type": "string", "minLength": 1},
                            "scale": {"type": "number", "exclusiveMinimum": 0}},
             "additionalProperties": false},
    "extras": {}
   },
   "additionalProperties": false},
  "source": {
   "type": "object", "required": ["data_structure", "kind"],
   "properties": {"data_structure": {"type": "string", "minLength": 1},
                  "kind": {"enum": ["mesh", "segments", "grid"]},
                  "mesh": {"type": "string", "minLength": 1},
                  "entity_set": {"type": "string", "minLength": 1}},
   "additionalProperties": false,
   "allOf": [
    {"if": {"properties": {"kind": {"const": "mesh"}}}, "then": {"required": ["mesh"]}},
    {"if": {"properties": {"kind": {"const": "segments"}}}, "then": {"required": ["entity_set"]}}]},
  "condition": {
   "description": "A value, a list of values (labels and other text by name), or a comparison such as \">=0\" or \"!=2\".",
   "oneOf": [{"type": ["number", "boolean"]},
             {"type": "string", "minLength": 1},
             {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]}
 }
}
